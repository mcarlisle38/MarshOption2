from __future__ import annotations

import re
import csv
import json
import os
import sqlite3
from dataclasses import dataclass
from datetime import datetime, timezone
from decimal import Decimal, InvalidOperation, ROUND_HALF_UP
from pathlib import Path
from typing import Any, Iterable, Mapping, Protocol
import xml.etree.ElementTree as ET

if os.name == "nt":
    import msvcrt
else:
    import fcntl


class ValidationError(Exception):
    pass


@dataclass(frozen=True)
class NormalizedTransaction:
    transaction_uti: str
    isin: str
    notional: Decimal
    notional_currency: str
    eur_notional: Decimal
    transaction_type: str
    transaction_datetime: str
    exchange_rate: Decimal
    legal_entity_identifier: str


class IFieldValidator(Protocol):
    def normalize_transaction(self, raw: Mapping[str, Any]) -> NormalizedTransaction:
        ...


class SharedFieldValidator(IFieldValidator):
    _max_notional = Decimal("99999999.0")
    _one_dp = Decimal("0.1")
    _ten_dp = Decimal("0.0000000001")

    def normalize_transaction(self, raw: Mapping[str, Any]) -> NormalizedTransaction:
        normalized_map = {str(k).lower(): v for k, v in raw.items()}

        transaction_uti = self._validate_transaction_uti(self._required_text(normalized_map, "transaction_uti"))
        isin = self._validate_isin(self._required_text(normalized_map, "isin"))
        notional = self._validate_notional(self._required_value(normalized_map, "notional"))
        notional_currency = self._validate_currency(self._required_text(normalized_map, "notional_currency"))
        transaction_type = self._validate_transaction_type(self._required_text(normalized_map, "transaction_type"))
        transaction_datetime = self._validate_datetime(self._required_text(normalized_map, "transaction_datetime"))
        exchange_rate = self._validate_exchange_rate(self._required_value(normalized_map, "exchange_rate"))
        legal_entity_identifier = self._validate_lei(self._required_text(normalized_map, "legal_entity_identifier"))

        eur_notional = self._validate_eur_notional(notional * exchange_rate)

        return NormalizedTransaction(
            transaction_uti=transaction_uti,
            isin=isin,
            notional=notional,
            notional_currency=notional_currency,
            eur_notional=eur_notional,
            transaction_type=transaction_type,
            transaction_datetime=transaction_datetime,
            exchange_rate=exchange_rate,
            legal_entity_identifier=legal_entity_identifier,
        )

    def _required_text(self, source: Mapping[str, Any], key: str) -> str:
        value = source.get(key)
        if value is None:
            raise ValidationError(f"Missing required field '{key}'.")
        value_text = str(value).strip()
        if value_text == "":
            raise ValidationError(f"Field '{key}' cannot be empty.")
        return value_text

    def _required_value(self, source: Mapping[str, Any], key: str) -> Any:
        if key not in source:
            raise ValidationError(f"Missing required field '{key}'.")
        return source[key]

    def _validate_transaction_uti(self, value: str) -> str:
        if len(value) > 45 or not re.fullmatch(r"[A-Z0-9]+", value):
            raise ValidationError("Invalid transaction_uti value.")
        return value

    def _validate_isin(self, value: str) -> str:
        if len(value) > 12 or not re.fullmatch(r"[A-Za-z0-9]+", value):
            raise ValidationError("Invalid isin value.")
        return value.upper()

    def _validate_notional(self, value: Any) -> Decimal:
        decimal_value = self._to_decimal(value, "notional")
        if decimal_value < 0 or decimal_value > self._max_notional:
            raise ValidationError("notional is outside the accepted range.")
        if decimal_value != decimal_value.quantize(self._one_dp):
            raise ValidationError("notional must have no more than 1 decimal place.")
        return decimal_value.quantize(self._one_dp)

    def _validate_currency(self, value: str) -> str:
        if not re.fullmatch(r"[A-Za-z]{3}", value):
            raise ValidationError("Invalid notional_currency value.")
        return value.upper()

    def _validate_transaction_type(self, value: str) -> str:
        lowered = value.lower()
        if lowered not in {"buy", "sell"}:
            raise ValidationError("transaction_type must be Buy or Sell.")
        return lowered.capitalize()

    def _validate_datetime(self, value: str) -> str:
        candidate = value
        if candidate.endswith("Z"):
            candidate = f"{candidate[:-1]}+00:00"
        try:
            parsed = datetime.fromisoformat(candidate)
        except ValueError as ex:
            raise ValidationError("transaction_datetime is not a valid ISO date-time value.") from ex
        if parsed.tzinfo is None:
            raise ValidationError("transaction_datetime must include timezone information.")
        if parsed.microsecond != 0:
            raise ValidationError("transaction_datetime must only be accurate to seconds.")
        utc_value = parsed.astimezone(timezone.utc)
        return utc_value.strftime("%Y-%m-%dT%H:%M:%SZ")

    def _validate_exchange_rate(self, value: Any) -> Decimal:
        decimal_value = self._to_decimal(value, "exchange_rate")
        if decimal_value < 0:
            raise ValidationError("exchange_rate must be non-negative.")
        return decimal_value.quantize(self._ten_dp, rounding=ROUND_HALF_UP)

    def _validate_lei(self, value: str) -> str:
        if len(value) > 20 or not re.fullmatch(r"[A-Z0-9]+", value):
            raise ValidationError("Invalid legal_entity_identifier value.")
        return value

    def _validate_eur_notional(self, value: Decimal) -> Decimal:
        rounded = value.quantize(self._one_dp, rounding=ROUND_HALF_UP)
        if rounded < 0 or rounded > self._max_notional:
            raise ValidationError("eur_notional is outside the accepted range.")
        return rounded

    def _to_decimal(self, value: Any, field_name: str) -> Decimal:
        try:
            decimal_value = Decimal(str(value))
        except (InvalidOperation, ValueError, TypeError) as ex:
            raise ValidationError(f"{field_name} is not a valid numeric value.") from ex
        if not decimal_value.is_finite():
            raise ValidationError(f"{field_name} must be a finite numeric value.")
        return decimal_value


class IFileFormatValidator(Protocol):
    def validate(self, file_path: Path) -> None:
        ...


class ITransactionParserStrategy(Protocol):
    def parse(self, file_path: Path) -> Iterable[Mapping[str, Any]]:
        ...


class CsvFileFormatValidator(IFileFormatValidator):
    _required_fields = {
        "transaction_uti",
        "isin",
        "notional",
        "notional_currency",
        "transaction_type",
        "transaction_datetime",
        "exchange_rate",
        "legal_entity_identifier",
    }

    def validate(self, file_path: Path) -> None:
        with file_path.open("r", encoding="utf-8", newline="") as handle:
            reader = csv.reader(handle, delimiter=",")
            try:
                header = next(reader)
            except StopIteration as ex:
                raise ValidationError(f"CSV file '{file_path.name}' is empty.") from ex

            normalized_header = {column.strip().lower() for column in header}
            if normalized_header != self._required_fields:
                raise ValidationError(f"CSV file '{file_path.name}' does not contain the expected header.")


class JsonFileFormatValidator(IFileFormatValidator):
    _required_fields = {
        "transaction_uti",
        "isin",
        "notional",
        "notional_currency",
        "transaction_type",
        "transaction_datetime",
        "exchange_rate",
        "lei",
    }

    def validate(self, file_path: Path) -> None:
        with file_path.open("r", encoding="utf-8") as handle:
            try:
                payload = json.load(handle)
            except json.JSONDecodeError as ex:
                raise ValidationError(f"JSON file '{file_path.name}' is not valid JSON.") from ex

        if not isinstance(payload, dict):
            raise ValidationError(f"JSON file '{file_path.name}' must contain an object at root level.")

        transactions_key = next((key for key in payload.keys() if key.lower() == "transactions"), None)
        if transactions_key is None:
            raise ValidationError(f"JSON file '{file_path.name}' must contain a transactions object.")

        transactions = payload[transactions_key]
        if not isinstance(transactions, list):
            raise ValidationError(f"JSON file '{file_path.name}' transactions must be a list.")

        for index, transaction in enumerate(transactions):
            if not isinstance(transaction, dict):
                raise ValidationError(f"JSON file '{file_path.name}' contains non-object transaction at index {index}.")
            keys = {str(key).lower() for key in transaction.keys()}
            if not self._required_fields.issubset(keys):
                raise ValidationError(f"JSON file '{file_path.name}' transaction at index {index} is missing required fields.")


class XmlFileFormatValidator(IFileFormatValidator):
    _required_fields = {
        "transaction_uti",
        "isin",
        "notional",
        "notional_currency",
        "transaction_type",
        "transaction_datetime",
        "exchange_rate",
        "lei",
    }

    def validate(self, file_path: Path) -> None:
        try:
            tree = ET.parse(file_path)
        except ET.ParseError as ex:
            raise ValidationError(f"XML file '{file_path.name}' is not valid XML.") from ex

        root = tree.getroot()
        if root.tag.lower() != "transactions":
            raise ValidationError(f"XML file '{file_path.name}' root element must be transactions.")

        transaction_nodes = [node for node in root if node.tag.lower() == "transaction"]
        for index, node in enumerate(transaction_nodes):
            children = {child.tag.lower() for child in node}
            if not self._required_fields.issubset(children):
                raise ValidationError(f"XML file '{file_path.name}' transaction at index {index} is missing required fields.")


class CsvParserStrategy(ITransactionParserStrategy):
    def parse(self, file_path: Path) -> Iterable[Mapping[str, Any]]:
        with file_path.open("r", encoding="utf-8", newline="") as handle:
            reader = csv.DictReader(handle, delimiter=",")
            for row in reader:
                yield {str(key).lower(): value for key, value in row.items()}


class JsonParserStrategy(ITransactionParserStrategy):
    def parse(self, file_path: Path) -> Iterable[Mapping[str, Any]]:
        with file_path.open("r", encoding="utf-8") as handle:
            payload = json.load(handle)

        transactions_key = next(key for key in payload.keys() if key.lower() == "transactions")
        for transaction in payload[transactions_key]:
            normalized = {str(key).lower(): value for key, value in transaction.items()}
            if "legal_entity_identifier" not in normalized and "lei" in normalized:
                normalized["legal_entity_identifier"] = normalized["lei"]
            yield normalized


class TransactionParserFactory:
    def __init__(
        self,
        validators: Mapping[str, IFileFormatValidator],
        strategies: Mapping[str, ITransactionParserStrategy],
    ) -> None:
        self._validators = validators
        self._strategies = strategies

    def create(self, file_path: Path) -> ITransactionParserStrategy:
        extension = file_path.suffix.lower()
        validator = self._validators.get(extension)
        strategy = self._strategies.get(extension)

        if validator is None or strategy is None:
            raise ValidationError(f"Unsupported input file type: '{file_path.name}'.")

        validator.validate(file_path)
        return strategy


class IFileLockChecker(Protocol):
    def ensure_readable(self, file_path: Path) -> None:
        ...


class FileLockChecker(IFileLockChecker):
    def ensure_readable(self, file_path: Path) -> None:
        if os.name == "nt":
            self._check_windows_lock(file_path)
        else:
            self._check_unix_lock(file_path)

    def _check_windows_lock(self, file_path: Path) -> None:
        try:
            with file_path.open("r+b") as handle:
                msvcrt.locking(handle.fileno(), msvcrt.LK_NBLCK, 1)
                msvcrt.locking(handle.fileno(), msvcrt.LK_UNLCK, 1)
        except OSError as ex:
            raise ValidationError(f"File is locked and cannot be read: {file_path.name}") from ex

    def _check_unix_lock(self, file_path: Path) -> None:
        try:
            with file_path.open("rb") as handle:
                fcntl.flock(handle.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
                fcntl.flock(handle.fileno(), fcntl.LOCK_UN)
        except OSError as ex:
            raise ValidationError(f"File is locked and cannot be read: {file_path.name}") from ex


class SqliteTransactionWriter:
    def __init__(self, output_file_path: Path) -> None:
        self._output_file_path = output_file_path

    def write(self, transactions: Iterable[NormalizedTransaction]) -> None:
        with sqlite3.connect(self._output_file_path) as connection:
            connection.execute(
                """
                CREATE TABLE output_dataset (
                    transaction_uti TEXT NOT NULL,
                    isin TEXT NOT NULL,
                    notional REAL NOT NULL,
                    notional_currency TEXT NOT NULL,
                    eur_notional REAL NOT NULL,
                    transaction_type TEXT NOT NULL,
                    transaction_datetime TEXT NOT NULL,
                    exchange_rate REAL NOT NULL,
                    legal_entity_identifier TEXT NOT NULL
                )
                """
            )
            connection.executemany(
                """
                INSERT INTO output_dataset (
                    transaction_uti,
                    isin,
                    notional,
                    notional_currency,
                    eur_notional,
                    transaction_type,
                    transaction_datetime,
                    exchange_rate,
                    legal_entity_identifier
                ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)
                """,
                [
                    (
                        transaction.transaction_uti,
                        transaction.isin,
                        float(transaction.notional),
                        transaction.notional_currency,
                        float(transaction.eur_notional),
                        transaction.transaction_type,
                        transaction.transaction_datetime,
                        float(transaction.exchange_rate),
                        transaction.legal_entity_identifier,
                    )
                    for transaction in transactions
                ],
            )


class TransactionProcessorApplication:
    _supported_extensions = {".csv", ".json", ".xml"}

    def __init__(
        self,
        working_directory: Path,
        parser_factory: TransactionParserFactory,
        field_validator: IFieldValidator,
        lock_checker: IFileLockChecker,
    ) -> None:
        self._working_directory = working_directory
        self._parser_factory = parser_factory
        self._field_validator = field_validator
        self._lock_checker = lock_checker

    def run(self) -> None:
        input_files = self._discover_input_files()
        for file_path in input_files:
            self._lock_checker.ensure_readable(file_path)

        transactions: list[NormalizedTransaction] = []
        for file_path in input_files:
            parser = self._parser_factory.create(file_path)
            for raw_transaction in parser.parse(file_path):
                transactions.append(self._field_validator.normalize_transaction(raw_transaction))

        output_path = self._working_directory / "output_dataset"
        if output_path.exists():
            output_path.unlink()

        writer = SqliteTransactionWriter(output_path)
        writer.write(transactions)

    def _discover_input_files(self) -> list[Path]:
        files = [
            item
            for item in self._working_directory.iterdir()
            if item.is_file() and item.suffix.lower() in self._supported_extensions
        ]
        return sorted(files, key=lambda item: item.name.lower())


def build_application(working_directory: Path) -> TransactionProcessorApplication:
    validators: dict[str, IFileFormatValidator] = {
        ".csv": CsvFileFormatValidator(),
        ".json": JsonFileFormatValidator(),
        ".xml": XmlFileFormatValidator(),
    }
    strategies: dict[str, ITransactionParserStrategy] = {
        ".csv": CsvParserStrategy(),
        ".json": JsonParserStrategy(),
        ".xml": XmlParserStrategy(),
    }

    parser_factory = TransactionParserFactory(validators=validators, strategies=strategies)
    return TransactionProcessorApplication(
        working_directory=working_directory,
        parser_factory=parser_factory,
        field_validator=SharedFieldValidator(),
        lock_checker=FileLockChecker(),
    )


def main() -> int:
    application_directory = Path(__file__).resolve().parent
    application = build_application(application_directory)
    try:
        application.run()
    except (ValidationError, OSError, sqlite3.DatabaseError) as ex:
        print(str(ex))
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())


class XmlParserStrategy(ITransactionParserStrategy):
    def parse(self, file_path: Path) -> Iterable[Mapping[str, Any]]:
        tree = ET.parse(file_path)
        root = tree.getroot()

        for transaction in root:
            if transaction.tag.lower() != "transaction":
                continue
            normalized = {child.tag.lower(): (child.text or "").strip() for child in transaction}
            if "legal_entity_identifier" not in normalized and "lei" in normalized:
                normalized["legal_entity_identifier"] = normalized["lei"]
            yield normalized
